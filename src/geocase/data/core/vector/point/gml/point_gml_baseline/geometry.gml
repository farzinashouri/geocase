<?xml version="1.0" encoding="utf-8" ?>
<ogr:FeatureCollection
     gml:id="aFeatureCollection"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://ogr.maptools.org/ geometry.xsd"
     xmlns:ogr="http://ogr.maptools.org/"
     xmlns:gml="http://www.opengis.net/gml/3.2">
  <gml:boundedBy><gml:Envelope srsName="urn:ogc:def:crs:EPSG::4326"><gml:lowerCorner>50.5 10.5</gml:lowerCorner><gml:upperCorner>50.5 10.5</gml:upperCorner></gml:Envelope></gml:boundedBy>
                                                                                                                                                                  
  <ogr:featureMember>
    <ogr:geometry gml:id="geometry.0">
      <gml:boundedBy><gml:Envelope srsName="urn:ogc:def:crs:EPSG::4326"><gml:lowerCorner>50.5 10.5</gml:lowerCorner><gml:upperCorner>50.5 10.5</gml:upperCorner></gml:Envelope></gml:boundedBy>
      <ogr:geometryProperty><gml:Point srsName="urn:ogc:def:crs:EPSG::4326" gml:id="geometry.geom.0"><gml:pos>50.5 10.5</gml:pos></gml:Point></ogr:geometryProperty>
      <ogr:name>baseline_point</ogr:name>
    </ogr:geometry>
  </ogr:featureMember>
</ogr:FeatureCollection>
