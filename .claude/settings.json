{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git clean *)",
      "Bash(find * -delete)",
      "Bash(find * -exec rm *)"
    ],
    "deny": [
      "Bash(git revert *)"
    ]
  }
}
