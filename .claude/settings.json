{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue create *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git clean *)",
      "Bash(find * -delete)",
      "Bash(find * -exec rm *)"
    ],
    "deny": [
      "Bash(git revert *)"
    ]
  }
}
